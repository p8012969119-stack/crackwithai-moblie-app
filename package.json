{
  "name": "CrackWithAI",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --scheme crackwithai",
    "start": "react-native start",
    "dev": "(PORT=5001 SKIP_BOOTSTRAP_SEED=true node backend/start-with-db.js &) && react-native run-ios",
    "typecheck": "tsc --noEmit",
    "backend": "node backend/start-with-db.js",
    "test:workshop": "node backend/tests/workshop.test.js && node backend/tests/workshop-provider.test.js",
    "test:fullstack": "node backend/tests/fullstack-curriculum.test.js",
    "test:fullstack-workspace": "node backend/tests/fullstack-workspace.test.js",
    "test:all-courses": "node backend/tests/fullstack-all-courses.test.js",
    "test:certificate": "node backend/tests/fullstack-certificate.test.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "axios": "^1.7.2",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-image-picker": "^8.3.0",
    "react-native-safe-area-context": "^4.10.1",
    "react-native-screens": "^3.31.1",
    "react-native-tts": "^4.1.1",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@react-native-community/cli": "^13.6.9",
    "@react-native/babel-preset": "^0.74.84",
    "@react-native/metro-config": "^0.74.84",
    "@types/react": "^18.2.79",
    "typescript": "^5.4.5"
  }
}
